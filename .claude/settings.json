{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node directus/schema/setup-schema.mjs)",
      "Bash(node directus/schema/seed-data.mjs)",
      "Bash(node directus/schema/setup-roles.mjs)",
      "Bash(node directus/schema/verify.mjs)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose restart:*)",
      "Bash(curl -s http://localhost:8055/:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx expo install:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "workflowSizeGuideline": "small"
}
